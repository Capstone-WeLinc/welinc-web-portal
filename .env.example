# Required (spec 0010): vite and vite build stop with a list when it is missing or malformed.
# A production build (npm run build) also needs https and no localhost; local builds use npm run build:local.
# VITE_* values ship to the browser: never put a secret here.
# The gateway the browser calls. Each system's address comes from welinc-auth's login answer (spec 0003).
VITE_API_BASE_URL=http://localhost:3000

# Error monitoring (VRMS spec 0025). All optional: leave them blank locally and nothing is sent.
# To prove it from your laptop, set the welinc-portal project's DSN and VITE_SENTRY_ENVIRONMENT=staging.
# The deploy sets them hosted. A DSN can only send events, so it is fine in the browser.
VITE_SENTRY_DSN=
# staging or production
VITE_SENTRY_ENVIRONMENT=
# The commit SHA (the deploy job sets it)
VITE_SENTRY_RELEASE=
# The gateway route reports go through, <api>/monitoring/portal. Blank sends straight to Sentry.
VITE_SENTRY_TUNNEL=
# true only in the staging build: the /debug/sentry test page (suite admins, no menu link)
VITE_SENTRY_TEST_ROUTES=
